{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "passThroughEnv": [
        "FUNDER_PRIVATE_KEY",
        "FUND_AMOUNT",
        "FUND_BUDGET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "LLM_API_KEY"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "FUNDER_PRIVATE_KEY",
        "FUND_AMOUNT",
        "FUND_BUDGET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "LLM_API_KEY"
      ]
    },
    "start": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "FUNDER_PRIVATE_KEY",
        "FUND_AMOUNT",
        "FUND_BUDGET",
        "R2_ACCOUNT_ID",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "R2_BUCKET",
        "LLM_API_KEY"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}

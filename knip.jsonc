{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  // 预装内容开始使用后，移除对应豁免；过期配置提示也应使检查失败。
  "treatConfigHintsAsErrors": true,
  // Web 预留的 cn 入口。
  "ignoreFiles": ["apps/web/src/lib/utils.ts"],
  "workspaces": {
    ".": {
      // 数据库正式接入后配置迁移工具。
      "ignoreDependencies": ["drizzle-kit"],
    },
    "apps/web": {
      "ignoreDependencies": [
        // UI SDK：空白页面尚未使用组件及行为 API。
        "@ui-sdk/core",
        "@ui-sdk/react",
        // 组件样式变体与各应用自己的 cn 入口。
        "class-variance-authority",
        "cn",
        // 数据库正式接入后使用。
        "drizzle-orm",
        // 随实际界面和运行时数据校验需求使用。
        "lucide-react",
        "zod",
        // 链交互与二维码：开工写业务代码后使用，届时移除。
        "qrcode.react",
        "viem",
      ],
    },
  },
}

# 应用环境变量示例；本地配置请写入 .env.local（不会提交到 git）。
# 浏览器可见的变量必须使用 NEXT_PUBLIC_ 前缀；私钥和密钥绝对不能加这个前缀。

# ---- 前端可见 ----
# 霸屏合约地址（部署后填写）
NEXT_PUBLIC_CONTRACT_ADDRESS=
# Monad 测试网 RPC
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# R2 公开访问域名（r2.dev 子域名或自定义域名），用于拼接图片和视频地址
NEXT_PUBLIC_MEDIA_BASE_URL=

# Encumber 预算锁合约地址
NEXT_PUBLIC_ENCUMBER_ADDRESS=

# ---- 仅服务端 ----
# 给新玩家发币的钱包私钥（只放测试币）
FUNDER_PRIVATE_KEY=
# 每个新玩家领取的 MON 数量
FUND_AMOUNT=0.2
# 发币总预算上限（MON）
FUND_BUDGET=10
# Cloudflare R2（签发预签名上传地址）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 可选：大模型 API Key（仅 AI 解说加分项）
LLM_API_KEY=
# Encumber 演示用的两个 Agent 私钥和服务商收款地址（bun run deploy:encumber 自动生成）
AGENT_A_KEY=
AGENT_B_KEY=
VENDOR_A_KEY=
VENDOR_B_KEY=
VENDOR_A_ADDRESS=
VENDOR_B_ADDRESS=
# 演示口令：控制台用 ?key=口令 打开才能发交易，否则只读
DEMO_KEY=
# 每轮演示的预算规模（MON）
DEMO_ROUND=0.1
